{
  "name": "opencode-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an orchestrator (Cursor, Claude Code, any MCP client) drive OpenCode: assign_task, models_list, score_to_agent, fetch_session.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opencode-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node test/harness.mjs",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "mcp",
    "opencode",
    "agent",
    "orchestrator",
    "acp"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
