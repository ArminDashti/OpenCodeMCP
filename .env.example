# Copy to .env and adjust. Used by docker compose.
# OpenCode HTTP API on the host (Docker Desktop: host.docker.internal).
OPENCODE_URL=http://host.docker.internal:4096
OPENCODE_PASSWORD=

# Dashboard login (seeded when no users exist yet).
# WEBUI_USERNAME=armin
# WEBUI_PASSWORD=
# WEBUI_EMAIL=armin@local

# WebUI container bind (loopback on host via port map; 0.0.0.0 inside Docker).
# WEBUI_HOST=0.0.0.0

# Host path mounted as /workspace inside the MCP container (OpenCode task cwd).
WORKSPACE_HOST=.

# Optional override inside the container (usually leave default).
# OPENCODE_DIRECTORY=/workspace
